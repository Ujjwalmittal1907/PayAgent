NODE_ENV=development
PORT=8788

# Telegram (create via @BotFather; NEVER commit the real token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_IDS=

# AI (optional — deterministic regex parser works without it; set to enable LLM intent extraction)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# KeeperHub (Settings > Developer > API keys > Organisation key kh_...)
KEEPERHUB_API_KEY=kh_...
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# Chains — ethereum-sepolia is the funded/proven path (wallet holds Sepolia USDC);
# base-sepolia works identically once the Turnkey wallet is funded (Circle faucet: https://faucet.circle.com)
CHAIN_ID=11155111
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
USDC_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Policy (USD, configurable — never hard-code elsewhere)
PAYMENT_AUTO_APPROVE_LIMIT_USD=1
PAYMENT_HUMAN_APPROVAL_LIMIT_USD=10
PAYMENT_DAILY_LIMIT_USD=10
MAX_SINGLE_PAYMENT_USD=10
ALLOWED_TOKENS=USDC
ALLOWED_NETWORKS=ethereum-sepolia,base-sepolia
# ALLOWED_RECIPIENTS=0xabc...,0xdef...

REQUIRED_APPROVALS=1
PROPOSAL_EXPIRY_MINUTES=15
DATABASE_URL="file:./dev.db"
