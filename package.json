{
  "name": "payagent",
  "version": "0.1.0",
  "description": "PayAgent — Secure payments for AI agents, executed deterministically. Telegram payment desk + KeeperHub execution on Base Sepolia.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "bot": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "telegraf": "^4.16.3",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "@types/node": "^22.20.2",
    "prisma": "^5.18.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
